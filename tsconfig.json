{
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "jsx": "react",
    "esModuleInterop": true,
    "strict": true,
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", "remotion.config.ts"]
}
